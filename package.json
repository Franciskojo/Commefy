{
  "name": "storeforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "tsx --env-file=.env.local --conditions=react-server scripts/db-init.ts",
    "db:seed": "tsx --env-file=.env.local --conditions=react-server scripts/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "mongodb": "^7.7.0",
    "next": "^16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
